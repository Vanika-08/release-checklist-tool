# ---------- docker compose (root .env) ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=releases

# ---------- backend (backend/.env for local runs; set in the host's dashboard in production) ----------
# PostgreSQL connection string. Neon/Render/Railway give you one; append ?sslmode=require for hosted DBs.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/releases
# Port the API listens on (hosts like Render inject this).
PORT=4000
# Comma-separated browser origins allowed by CORS. Use your deployed frontend URL in production, never "*".
CORS_ORIGIN=http://localhost:5173
# Max pg connections per API instance. Keep (instances x this) below the DB's connection limit.
DB_POOL_MAX=10
# Only used by `npm test`: a throwaway database that tests will wipe.
TEST_DATABASE_URL=postgresql://postgres:change-me@localhost:5432/releases_test

# ---------- frontend (frontend/.env.local; set in Vercel for production) ----------
# Full URL of the GraphQL endpoint.
VITE_GRAPHQL_URL=http://localhost:4000/graphql
