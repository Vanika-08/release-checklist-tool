# docker compose (root .env)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=releases

# backend (backend/.env locally; set in the host dashboard in production)
# docker compose exposes Postgres on host port 5433. Hosted DBs: add ?sslmode=require
DATABASE_URL=postgresql://postgres:change-me@localhost:5433/releases
PORT=4000
# Comma-separated allowed origins. Use the deployed frontend URL in production, not "*".
CORS_ORIGIN=http://localhost:5173
# Keep (instances x DB_POOL_MAX) below the database's connection limit.
DB_POOL_MAX=10
# Used by `npm test`. This database gets wiped.
TEST_DATABASE_URL=postgresql://postgres:change-me@localhost:5433/releases_test

# frontend (frontend/.env.local; set in Vercel for production)
VITE_GRAPHQL_URL=http://localhost:4000/graphql