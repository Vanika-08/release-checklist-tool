generator client {
  provider           = "prisma-client"
  output             = "../src/generated/prisma"
  moduleFormat       = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Steps are defined in src/domain/steps.ts; status is derived from completedSteps, not stored.
model Release {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @unique @db.VarChar(200)
  date           DateTime @db.Timestamptz(3)
  additionalInfo String?
  completedSteps Json     @default("[]") @db.JsonB
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  // The list is ordered by date DESC, id ASC and paginated.
  @@index([date(sort: Desc), id])
}
