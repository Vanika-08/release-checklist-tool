generator client {
  provider           = "prisma-client"
  output             = "../src/generated/prisma"
  moduleFormat       = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// A software release. Steps are fixed in code (src/domain/steps.ts);
/// only the IDs of completed steps are persisted, as a JSONB array.
/// Status is NOT stored: it is derived from completedSteps on read.
model Release {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(200)
  date           DateTime @db.Timestamptz(3)
  additionalInfo String?
  completedSteps Json     @default("[]") @db.JsonB
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  // The list is ordered by date DESC, id ASC and paginated.
  @@index([date(sort: Desc), id])
}
